{"id":"Prowl.Runtime.NavMeshQueryLease","name":"NavMeshQueryLease","display":"NavMeshQueryLease","kind":"struct","assembly":"Prowl.Runtime","namespace":"Prowl.Runtime","outer":null,"signature":"public ref struct NavMeshQueryLease","bases":[],"docs":{"summary":"A rented thread-safe navmesh query. Dispose to return it to the pool. Leases hold a read lock on the navmesh, so keep them short-lived. A ref struct so a lease cannot be stored in a field, boxed, captured or held across an await, which is how a read lock outlives its frame."},"attributes":[],"members":[{"kind":"property","name":"Query","signature":"public DtNavMeshQuery Query { get; }","docs":{"summary":"The Detour query, valid until this lease is disposed."},"static":false,"obsolete":false,"line":319,"path":"Prowl.Runtime/Navigation/NavMeshPrimitives.cs","anchor":"Query"},{"kind":"method","name":"Dispose","signature":"public void Dispose()","docs":{},"static":false,"obsolete":false,"line":329,"path":"Prowl.Runtime/Navigation/NavMeshPrimitives.cs","anchor":"Dispose"}],"source":{"repo":"ProwlEngine/Prowl","path":"Prowl.Runtime/Navigation/NavMeshPrimitives.cs","line":314}}