{"id":"Prowl.OrigamiUI.GraphNode","name":"GraphNode","display":"GraphNode","kind":"class","assembly":"Prowl.Origami","namespace":"Prowl.OrigamiUI","outer":null,"signature":"public sealed class GraphNode","bases":[],"docs":{"summary":"A node. [`Position`](#api~Prowl.Scaffold.Position) is graph space (unscaled). Ports are split into [`Inputs`](#api~Prowl.OrigamiUI.GraphNode~Inputs) / [`Outputs`](#api~Prowl.OrigamiUI.GraphNode~Outputs) (data-flow direction); each port's [`Side`](#api~Prowl.OrigamiUI.GraphPort~Side) chooses which edge it renders on, so a horizontal data node and a vertical behaviour-tree node share one code path."},"attributes":[],"members":[{"kind":"field","name":"Id","signature":"public string Id","docs":{},"static":false,"obsolete":false,"line":131,"path":"Origami/Origami/Widgets/NodeGraph.cs","anchor":"Id"},{"kind":"field","name":"Title","signature":"public string Title","docs":{},"static":false,"obsolete":false,"line":132,"path":"Origami/Origami/Widgets/NodeGraph.cs","anchor":"Title"},{"kind":"field","name":"Position","signature":"public Float2 Position","docs":{},"static":false,"obsolete":false,"line":133,"path":"Origami/Origami/Widgets/NodeGraph.cs","anchor":"Position"},{"kind":"field","name":"Width","signature":"public float Width","docs":{},"static":false,"obsolete":false,"line":134,"path":"Origami/Origami/Widgets/NodeGraph.cs","anchor":"Width"},{"kind":"field","name":"Icon","signature":"public IOrigamiIcon? Icon","docs":{},"static":false,"obsolete":false,"line":135,"path":"Origami/Origami/Widgets/NodeGraph.cs","anchor":"Icon"},{"kind":"field","name":"Accent","signature":"public Color? Accent","docs":{},"static":false,"obsolete":false,"line":136,"path":"Origami/Origami/Widgets/NodeGraph.cs","anchor":"Accent"},{"kind":"field","name":"Inputs","signature":"public List<GraphPort> Inputs","docs":{},"static":false,"obsolete":false,"line":137,"path":"Origami/Origami/Widgets/NodeGraph.cs","anchor":"Inputs"},{"kind":"field","name":"Outputs","signature":