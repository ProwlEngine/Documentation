t below the port rows. Set [`BodyHeight`](#api~Prowl.OrigamiUI.GraphNode~BodyHeight) to the space it needs; without it the node is a title and its port labels, as before."},"static":false,"obsolete":false,"line":164,"path":"Origami/Origami/Widgets/NodeGraph.cs","anchor":"Body"},{"kind":"field","name":"BodyHeight","signature":"public float BodyHeight","docs":{"summary":"Height reserved for [`Body`](#api~Prowl.OrigamiUI.GraphNode~Body), in graph space."},"static":false,"obsolete":false,"line":167,"path":"Origami/Origami/Widgets/NodeGraph.cs","anchor":"BodyHeight"},{"kind":"field","name":"Rows","signature":"public List<GraphNodeRow> Rows","docs":{"summary":"Rows of controls below the port rows, each at its own height. The card sizes itself from them and every row keeps its drags, so working a control never moves the node. Wins over [`Body`](#api~Prowl.OrigamiUI.GraphNode~Body)."},"static":false,"obsolete":false,"line":173,"path":"Origami/Origami/Widgets/NodeGraph.cs","anchor":"Rows"},{"kind":"field","name":"Collapsible","signature":"public bool Collapsible","docs":{"summary":"Shows a chevron in the header that raises `OnNodeToggleCollapsed`."},"static":false,"obsolete":false,"line":176,"path":"Origami/Origami/Widgets/NodeGraph.cs","anchor":"Collapsible"},{"kind":"field","name":"Collapsed","signature":"public bool Collapsed","docs":{"summary":"Draw the header only. Ports stay live, spread down the header's edges."},"static":false,"obsolete":false,"line":179,"path":"Origami/Origami/Widgets/NodeGraph.cs","anchor":"Collapsed"},{"kind":"field","name":"HeaderOnly","signature":"public bool HeaderOnly","docs":{"summary":"A node that is only ever its header, for something with a name and a port and nothing to set: always folded, no chevron, and its output's label shown at the right of the header."},"static":false,"obsolete":false,"line":185,"path":"Origami/Origami/Widgets/NodeGraph.cs","anchor":"HeaderOnly"},{"kind":"field","name":"Pinned","signature":"public bool Pinned","docs