{"id":"Prowl.Runtime.WheelCollider","name":"WheelCollider","display":"WheelCollider","kind":"class","assembly":"Prowl.Runtime","namespace":"Prowl.Runtime","outer":null,"signature":"public sealed class WheelCollider : Component","bases":[{"name":"Component","id":"Prowl.Runtime.Component"}],"docs":{"summary":"A raycast-vehicle wheel. Ground contact is a grid of downward rays across the wheel face. Each ray finds the surface below it, and the wheel's contact with that surface is solved exactly for its round profile, so it sits precisely on slopes and still rides over bumps and kerbs between rays. Suspension is a spring and damper tuned from a natural frequency, and grip follows a friction curve on slip ratio and slip angle, solved together with the wheel's spin so it stays stable for any mass and holds still on slopes and moving platforms. The wheel applies forces to the nearest enabled [`Rigidbody3D`](#api~Prowl.Runtime.Rigidbody3D) above it; it does not add a collision shape of its own. Place the wheel GameObject so its position marks the top of the suspension travel; the wheel hangs below along -up. Positive [`SteerAngle`](#api~Prowl.Runtime.WheelCollider~SteerAngle) turns toward the wheel's right."},"attributes":["AddComponentMenu","ComponentIcon"],"members":[{"kind":"field","name":"SteerAngle","signature":"public float SteerAngle","docs":{"summary":"Steering angle in radians about the suspension axis, positive toward the wheel's right. Set by a controller."},"static":false,"obsolete":false,"line":177,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"SteerAngle"},{"kind":"field","name":"MotorTorque","signature":"public float MotorTorque","docs":{"summary":"Drive torque in N m applied to the wheel spin. Set by a controller each frame."},"static":false,"obsolete":false,"line":180,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"MotorTorque"},{"kind":"field","name":"BrakeTorque","signature":"public float BrakeTorque","docs":{"summary":"Brake torque in N m opposing the wheel spin. Set by a controller each frame. Negative values count as zero."},"static":false,"obsolete":false,"line":183,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"BrakeTorque"},{"kind":"field","name":"VisualTransform","signature":"public Transform VisualTransform","docs":{"summary":"Optional visual wheel transform. When set it is placed at the wheel centre and rotated for steering (about the suspension axis) and spin (about the axle) each frame. Keep this separate from the WheelCollider's own GameObject, which marks the fixed suspension mount used by physics."},"static":false,"obsolete":false,"line":188,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"VisualTransform"},{"kind":"property","name":"Radius","signature":"public float Radius { get; set; }","docs":{},"static":false,"obsolete":false,"line":242,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"Radius"},{"kind":"property","name":"Width","signature":"public float Width { get; set; }","docs":{},"static":false,"obsolete":false,"line":243,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"Width"},{"kind":"property","name":"Camber","signature":"public float Camber { get; set; }","docs":{"summary":"Wheel tilt in degrees about the forward axis, mirrored per side so one value suits both. Positive leans the tops inward."},"static":false,"obsolete":false,"line":246,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"Camber"},{"kind":"property","name":"ForwardRayCount","signature":"public int ForwardRayCount { get; set; }","docs":{"summary":"Rays along the wheel's length. Always odd, so one ray sits under the wheel's centre."},"static":false,"obsolete":false,"line":249,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"ForwardRayCount"},{"kind":"property","name":"SideRayCount","signature":"public int SideRayCount { get; set; }","docs":{"summary":"Rays across the wheel's width."},"static":false,"obsolete":false,"line":252,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"SideRayCount"},{"kind":"property","name":"LayerMask","signature":"public LayerMask LayerMask { get; set; }","docs":{"summary":"The layers the wheel can rest on, on top of the layer collision rules for its body."},"static":false,"obsolete":false,"line":255,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"LayerMask"},{"kind":"property","name":"Depenetrate","signature":"public bool Depenetrate { get; set; }","docs":{"summary":"Push the wheel (and chassis) out along the contact normal when the suspension bottoms out against an object."},"static":false,"obsolete":false,"line":258,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"Depenetrate"},{"kind":"property","name":"SuspensionDistance","signature":"public float SuspensionDistance { get; set; }","docs":{},"static":false,"obsolete":false,"line":259,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"SuspensionDistance"},{"kind":"property","name":"SuspensionFrequency","signature":"public float SuspensionFrequency { get; set; }","docs":{"summary":"The spring's natural frequency in Hz, from 0.1 to 30. Higher is stiffer."},"static":false,"obsolete":false,"line":262,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"SuspensionFrequency"},{"kind":"property","name":"SuspensionDampingRatio","signature":"public float SuspensionDampingRatio { get; set; }","docs":{},"static":false,"obsolete":false,"line":263,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"SuspensionDampingRatio"},{"kind":"property","name":"SprungMass","signature":"public float SprungMass { get; set; }","docs":{"summary":"Sprung mass (kg) this wheel supports. 0 shares the body's mass evenly between its wheels."},"static":false,"obsolete":false,"line":266,"path":"Prowl.Runtime/Components/Physics/WheelCollider.cs","anchor":"SprungMass"},{"kind":"pro